# ==========================================
# COMMAND DASHBOARD ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# SUPABASE CONFIGURATION (PostgreSQL + Auth)
# Get these from https://supabase.com -> Project Settings -> API
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-optional

# ------------------------------------------
# GITHUB AUTOMATED SNAPSHOT PIPELINE
# Automatically commits updated JSON data on Add/Update/Delete
# ------------------------------------------
# GitHub Personal Access Token (with repo:write permission)
GITHUB_ACCESS_TOKEN=ghp_yourPersonalAccessTokenHere
# The repository where the snapshot should be committed, e.g. "my-username/command-dashboard"
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=your-repo-name
# File path in repo to store the snapshot
GITHUB_SNAPSHOT_PATH=data/records-snapshot.json
GITHUB_BRANCH=main

# ------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------
# Set to "false" when you have plugged in your real Supabase credentials.
# Set to "true" (default if keys missing) to explore in instant mock/demo mode.
NEXT_PUBLIC_DEMO_MODE=false
